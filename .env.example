# Copy this file to ".env" and fill in your values.
# Create an API token at: https://id.atlassian.com/manage-profile/security/api-tokens
# The .env file is gitignored — never commit your real token.

JIRA_SITE=growth99.atlassian.net
JIRA_EMAIL=mehul.kothari@growth99.com
JIRA_API_TOKEN=paste-your-api-token-here

# Google Chat "AI space" incoming webhook — used to post the EOD check-in.
# In the space: ⌄ menu → Apps & integrations → Manage webhooks → Add webhook → copy URL.
GCHAT_WEBHOOK_URL=paste-your-space-webhook-url-here

# Base URL the check-in ✅/❌ buttons link back to. Use a network-reachable
# address (not localhost) if teammates will click from their own machines.
DASHBOARD_URL=http://localhost:5173

# Durable store for check-in responses & task edits (required on Vercel, whose
# filesystem is ephemeral). Create a Vercel KV / Upstash store and Vercel sets
# these automatically; locally they're optional (falls back to a JSON file).
# KV_REST_API_URL=https://xxx.upstash.io
# KV_REST_API_TOKEN=xxxxxxxx
